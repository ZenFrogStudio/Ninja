{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings-ui",
  "description": "Settings UI capabilities",
  "windows": ["settings"],
  "permissions": [
    "core:app:default",
    "core:event:default",
    "core:path:allow-resolve-directory",
    "core:path:default",
    "core:window:default",
    "dialog:default",
    "dialog:allow-open",
    "shell:default",
    "shell:allow-open",
    "allow-widget-packs",
    "allow-widget-states",
    "allow-start-widget",
    "allow-start-widget-preset",
    "allow-stop-widget-preset",
    "allow-update-widget-config",
    "allow-create-widget-pack",
    "allow-update-widget-pack",
    "allow-delete-widget-pack",
    "allow-create-widget-config",
    "allow-delete-widget-config",
    "allow-listen-provider",
    "allow-unlisten-provider",
    "allow-call-provider-function",
    "allow-start-preview-widget",
    "allow-stop-all-preview-widgets",
    "allow-read-wm-settings",
    "allow-write-wm-settings"
  ]
}
