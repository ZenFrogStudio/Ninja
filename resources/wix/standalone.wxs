<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
    Name="Ninja"
    Version="$(var.VERSION_NUMBER)"
    UpgradeCode="fa00c176-4755-4390-aa8e-a151cf7abf75"
    Manufacturer="Ninja"
    Language="1033"
    Scope="perMachine"
  >
    <!--
      Reinstall all files; rewrite all registry entries; reinstall all shortcuts.
      Ref: https://docs.microsoft.com/en-us/windows/win32/msi/reinstallmode
    -->
    <Property Id="REINSTALLMODE" Value="amus" />

    <!-- Allow version downgrades. -->
    <MajorUpgrade Schedule="afterInstallInitialize" AllowDowngrades="yes" />

    <!--
      Removes the standalone "Ninja Bar" product left behind by installs
      from before the bar and the window manager became one binary.
      Without this, upgrading leaves an orphaned entry in Apps & features
      and a stale `ninja-bar.exe` on disk that nothing starts any more.

      A foreign `UpgradeCode` in this table is detected and uninstalled by
      `RemoveExistingProducts` just like our own. The code is stable across
      every version that MSI shipped — unlike the per-build ProductCode —
      because Tauri derives it from the bundle identifier.

      `OnlyDetect="no"` is what makes it a removal rather than a block, and
      `IgnoreRemoveFailure` keeps a machine that never had the bar, or has
      a wedged copy of it, from failing the whole install.
    -->
    <Upgrade Id="570D3DD8-FDBD-5B5C-A519-2FF34BA60B33">
      <UpgradeVersion
        Minimum="0.0.0"
        IncludeMinimum="yes"
        OnlyDetect="no"
        IgnoreRemoveFailure="yes"
        MigrateFeatures="no"
        Property="LEGACY_NINJA_BAR" />
    </Upgrade>

    <!-- Set icon used by installer. -->
    <Icon Id="Custom_Ico" SourceFile="resources/assets/icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="Custom_Ico" />

    <!-- Enable CAB embed, otherwise, a separate .cab file is created. -->
    <MediaTemplate EmbedCab="yes" />

		<UIRef Id="Custom_UI" />

    <!-- User input variables for whether to install shortcuts. -->
    <Property Id="ENABLE_DESKTOP_SHORTCUT" Secure="yes" />
    <Property Id="ENABLE_START_MENU_SHORTCUT" Value="1" Secure="yes" />

    <Feature Id="Custom_ProductFeature">
      <ComponentRef Id="Custom_CreateInstallDir" />
      <ComponentRef Id="Custom_InstallRootFiles" />
      <ComponentRef Id="Custom_InstallCliFiles" />
      <ComponentRef Id="Custom_AddDesktopShortcut" />
      <ComponentRef Id="Custom_AddStartMenuShortcut" />
      <ComponentRef Id="Custom_AddPathEnv" />
    </Feature>

    <!--
      The bar's MSI installs into this same directory. The WM resolves the
      bar binary as a sibling of its own executable, so the two must not be
      split across separate install folders.
    -->
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Ninja">
        <Component Id="Custom_CreateInstallDir">
          <RegistryValue
            Root="HKLM"
            Key="SOFTWARE\Ninja\wm"
            Name="InstallDir"
            Value="[INSTALLFOLDER]"
            Type="string"
            KeyPath="yes"
          />
        </Component>

        <!-- Add main + watcher executable. -->
        <Component Id="Custom_InstallRootFiles" Guid="73752F94-6589-4C7B-ABED-39D655A19714">
          <File Id="Custom_RootExe" Source="$(var.EXE_DIR)/ninja.exe" KeyPath="yes" />
          <File Id="Custom_RootWatcherExe" Source="$(var.EXE_DIR)/ninja-watcher.exe" />
        </Component>

        <!-- Add CLI executable. -->
        <Directory Id="Custom_CliDir" Name="cli">
          <Component Id="Custom_InstallCliFiles" Guid="916284d8-100c-4f37-8d8c-2722b01cb3dd">
            <File Id="Custom_CliExe" Source="$(var.EXE_DIR)/ninja-cli.exe" Name="ninja.exe" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <!-- Add shortcut to desktop. -->
    <StandardDirectory Id="DesktopFolder">
      <Component Id="Custom_AddDesktopShortcut" Condition="ENABLE_DESKTOP_SHORTCUT = 1">
        <Shortcut
          Id="Custom_DesktopShortcut"
          Name="Ninja"
          Description="Launch Ninja"
          Target="[INSTALLFOLDER]ninja.exe"
        />

        <RegistryValue
          Root="HKLM"
          Key="SOFTWARE\Ninja\wm"
          Name="DesktopShortcutInstalled"
          Type="integer"
          Value="1"
          KeyPath="yes"
        />
      </Component>
    </StandardDirectory>

    <!-- Add shortcut to Start Menu. -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="Custom_AddStartMenuShortcut" Condition="ENABLE_START_MENU_SHORTCUT = 1">
        <Shortcut
          Id="Custom_StartMenuShortcut"
          Name="Ninja"
          Description="Launch Ninja"
          Target="[INSTALLFOLDER]ninja.exe"
        />

        <RegistryValue
          Root="HKLM"
          Key="SOFTWARE\Ninja\wm"
          Name="StartMenuShortcutInstalled"
          Type="integer"
          Value="1"
          KeyPath="yes"
        />
      </Component>
    </StandardDirectory>

    <!--
      Add CLI directory to PATH. `INSTALLFOLDER` already ends in a
      separator, so `Value` must not add another one.
    -->
    <Component Id="Custom_AddPathEnv" Guid="66a4be46-19ae-4ed4-944f-b01673887f64" KeyPath="yes">
      <Environment
        Id="Custom_PathEnv"
        Value="[INSTALLFOLDER]cli"
        Name="PATH"
        Permanent="no"
        Part="first"
        Action="set"
        System="yes"
      />
    </Component>

    <!--
      Removes the "Run on system startup" entry the app writes, so an
      uninstall doesn't leave Explorer trying to launch a missing exe at
      every logon.

      A custom action rather than `RemoveRegistryValue`: that element
      deletes the value when its component is *installed*, so it wiped
      the user's startup setting on every upgrade. Windows Installer has
      no built-in way to remove a single value on uninstall.

      Runs only on a real uninstall. `UPGRADINGPRODUCTCODE` is set while
      an older version is being replaced, and the entry has to survive
      that. Impersonated so `HKCU` is the user's hive rather than
      SYSTEM's. `TARGETDIR` is the working directory because the install
      folder is already gone by this point.
    -->
    <CustomAction
      Id="Custom_RemoveRunEntry"
      Directory="TARGETDIR"
      ExeCommand="&quot;[System64Folder]reg.exe&quot; delete &quot;HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Run&quot; /v Ninja /f"
      Execute="deferred"
      Impersonate="yes"
      Return="ignore"
    />

    <InstallExecuteSequence>
      <Custom
        Action="Custom_RemoveRunEntry"
        Before="InstallFinalize"
        Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE"
      />
    </InstallExecuteSequence>
  </Package>
</Wix>
